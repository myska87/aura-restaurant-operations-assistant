{
  "name": "DocumentSignature",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string"
    },
    "document_title": {
      "type": "string"
    },
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "staff_email": {
      "type": "string"
    },
    "signed_date": {
      "type": "string",
      "format": "date-time"
    },
    "signature_data": {
      "type": "string"
    },
    "version_signed": {
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "staff_id",
    "signed_date"
  ]
}