{
  "name": "Sale",
  "type": "object",
  "properties": {
    "sale_number": {
      "type": "string",
      "description": "Unique sale reference"
    },
    "sale_type": {
      "type": "string",
      "enum": [
        "dine_in",
        "takeaway",
        "delivery"
      ],
      "default": "dine_in"
    },
    "items": {
      "type": "array",
      "description": "Sold items with quantities",
      "items": {
        "type": "object",
        "properties": {
          "menu_item_id": {
            "type": "string"
          },
          "menu_item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          },
          "total_cost": {
            "type": "number"
          },
          "add_ons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "add_on_id": {
                  "type": "string"
                },
                "add_on_name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "price": {
                  "type": "number"
                },
                "cost": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "total_price": {
      "type": "number"
    },
    "gross_profit": {
      "type": "number"
    },
    "gp_percentage": {
      "type": "number"
    },
    "stock_deducted": {
      "type": "boolean",
      "default": false,
      "description": "Flag if stock has been deducted"
    },
    "deduction_log": {
      "type": "array",
      "description": "Log of what was deducted",
      "items": {
        "type": "object",
        "properties": {
          "ingredient_id": {
            "type": "string"
          },
          "ingredient_name": {
            "type": "string"
          },
          "quantity_deducted": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "staff_email": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "sale_number",
    "items",
    "total_price"
  ]
}