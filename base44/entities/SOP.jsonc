{
  "name": "SOP",
  "type": "object",
  "properties": {
    "sop_code": {
      "type": "string",
      "description": "Unique SOP ID (e.g. A1.01, B2.03)"
    },
    "title": {
      "type": "string",
      "description": "SOP title"
    },
    "category": {
      "type": "string",
      "enum": [
        "operations",
        "food",
        "hygiene",
        "service",
        "safety",
        "admin"
      ],
      "description": "SOP category"
    },
    "purpose": {
      "type": "string",
      "description": "Why this SOP exists (1-2 lines)"
    },
    "who_is_responsible": {
      "type": "string",
      "description": "Role-based responsibility (not names)"
    },
    "when_it_applies": {
      "type": "string",
      "description": "Time, frequency, or trigger for this SOP"
    },
    "instructions": {
      "type": "array",
      "description": "Step-by-step visual-friendly instructions",
      "items": {
        "type": "object",
        "properties": {
          "step_number": {
            "type": "number"
          },
          "instruction": {
            "type": "string"
          },
          "duration_minutes": {
            "type": "number"
          },
          "photo_url": {
            "type": "string"
          }
        }
      }
    },
    "recipe_id": {
      "type": "string",
      "description": "Linked Recipe ID (optional)"
    },
    "recipe_name": {
      "type": "string",
      "description": "Recipe name for reference (optional)"
    },
    "critical_control_point": {
      "type": "boolean",
      "default": false,
      "description": "Is this a HACCP Critical Control Point?"
    },
    "critical_limit": {
      "type": "string",
      "description": "Critical limit for CCP (e.g. \u226575\u00b0C)"
    },
    "what_to_monitor": {
      "type": "string",
      "description": "What to monitor if CCP"
    },
    "corrective_action": {
      "type": "string",
      "description": "What happens if CCP fails"
    },
    "equipment_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Equipment needed"
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Max 3 common mistakes"
    },
    "confirmation_checklist": {
      "type": "string",
      "description": "Simple Yes/No checklist for task completion"
    },
    "linked_sops": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Links to related SOP IDs"
    },
    "hygiene_notes": {
      "type": "string",
      "description": "Hygiene requirements and warnings"
    },
    "allergen_notes": {
      "type": "string",
      "description": "Allergen handling instructions"
    },
    "allergens_present": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "milk",
          "eggs",
          "gluten",
          "peanuts",
          "nuts",
          "soy",
          "sesame",
          "mustard",
          "celery",
          "fish",
          "crustaceans",
          "molluscs",
          "lupin",
          "sulphites"
        ]
      },
      "description": "UK FSA 14 Major Allergens present"
    },
    "prep_time_minutes": {
      "type": "number",
      "description": "Total preparation time in minutes"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos or diagrams for visual reference"
    },
    "version": {
      "type": "string",
      "default": "1.0",
      "description": "SOP version number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "active",
      "description": "SOP status"
    },
    "approved_by": {
      "type": "string",
      "description": "Manager who approved"
    },
    "approved_date": {
      "type": "string",
      "format": "date",
      "description": "Approval date"
    },
    "is_locked": {
      "type": "boolean",
      "default": true,
      "description": "READ-ONLY for staff"
    }
  },
  "required": [
    "sop_code",
    "title"
  ]
}