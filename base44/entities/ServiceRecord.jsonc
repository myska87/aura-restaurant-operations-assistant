{
  "name": "ServiceRecord",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "description": "Reference to Asset"
    },
    "asset_name": {
      "type": "string",
      "description": "Asset name for reference"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "routine_maintenance",
        "repair",
        "calibration",
        "cleaning",
        "component_replacement",
        "inspection"
      ],
      "description": "Type of service"
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "When service was performed"
    },
    "service_provider": {
      "type": "string",
      "enum": [
        "internal_staff",
        "external_engineer"
      ],
      "description": "Who performed service"
    },
    "engineer_name": {
      "type": "string",
      "description": "Engineer/technician name if external"
    },
    "engineer_company": {
      "type": "string",
      "description": "Service company name"
    },
    "engineer_contact": {
      "type": "string",
      "description": "Engineer phone/email"
    },
    "internal_staff_id": {
      "type": "string",
      "description": "Internal staff member ID if internal"
    },
    "internal_staff_name": {
      "type": "string",
      "description": "Internal staff name"
    },
    "description": {
      "type": "string",
      "description": "Service description and work performed"
    },
    "parts_replaced": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          }
        }
      },
      "description": "Parts replaced during service"
    },
    "service_cost": {
      "type": "number",
      "description": "Total service cost"
    },
    "parts_cost": {
      "type": "number",
      "description": "Cost of parts only"
    },
    "labour_cost": {
      "type": "number",
      "description": "Labour cost"
    },
    "next_service_due": {
      "type": "string",
      "format": "date",
      "description": "When next service is due"
    },
    "certificate_url": {
      "type": "string",
      "description": "Service certificate/report PDF URL"
    },
    "invoice_url": {
      "type": "string",
      "description": "Invoice/receipt URL"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "cancelled"
      ],
      "default": "completed",
      "description": "Service status"
    }
  },
  "required": [
    "asset_id",
    "asset_name",
    "service_type",
    "service_date",
    "service_provider",
    "description"
  ]
}