{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "alert",
        "success",
        "reminder"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "shift",
        "training",
        "inventory",
        "sop",
        "quality",
        "meeting",
        "asset",
        "general"
      ]
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "action_url": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    }
  },
  "required": [
    "recipient_email",
    "title",
    "message",
    "type"
  ]
}